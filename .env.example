# ========================================================
# Variables de Entorno para Docker Compose - CollabCASE AI
# Copia este archivo a `.env` en la misma carpeta si deseas
# personalizar los valores predeterminados.
# ========================================================

# Base de Datos (PostgreSQL)
POSTGRES_DB=collabcase_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
# Se expone en el host en el puerto 5433 para evitar colisiones
# si ya tienes una instancia local de PostgreSQL en el puerto 5432:
POSTGRES_PORT=5433

# Backend Spring Boot
BACKEND_PORT=8080
JPA_SHOW_SQL=true
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:80,http://localhost,http://192.168.0.9:3000,http://192.168.0.9:5173

# Frontend React
FRONTEND_PORT=3000
VITE_API_URL=http://192.168.0.9:8080
VITE_WS_URL=ws://192.168.0.9:8080

# ========================================================
# Integraciones de Inteligencia Artificial (Opcionales)
# ========================================================

# Google Gemini API
GEMINI_API_KEY=

# Azure OpenAI
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=collabcase-gpt
AZURE_OPENAI_BASE_URL=https://collabcase-openai-2026-05452.openai.azure.com/openai/v1/responses

# Ollama Local (Ejecutándose en tu máquina host)
# Utiliza host.docker.internal para conectar el contenedor a tu máquina local:
OLLAMA_BASE_URL=http://host.docker.internal:11434/api/generate
OLLAMA_MODEL=llama3.2:1b

# Firebase push: activar tras configurar las credenciales del backend.
PUSH_ENABLED=false
